# ==============================================================================
# PolicyFlow - Environment Configuration Template
# ==============================================================================
# All sensitive credentials and local machine configurations must be set here.
# Placeholders are provided for all supported databases and services.

APP_NAME=PolicyFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Default is SQLite for instant zero-dependency local execution.
# To switch to MySQL or PostgreSQL, change DB_CONNECTION and fill the placeholders.

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=policyflow
# DB_USERNAME=policyflow_user
# DB_PASSWORD=your_secure_password_placeholder

# PostgreSQL Example:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=policyflow
# DB_USERNAME=postgres
# DB_PASSWORD=your_secure_password_placeholder

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# Redis & Cache (Optional)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Mock Insurer Configuration (Development / Testing)
# ------------------------------------------------------------------------------
MOCK_INSURER_DEFAULT_SCENARIO=SUCCESS
MOCK_INSURER_TIMEOUT_SECONDS=5
